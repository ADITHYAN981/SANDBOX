# =============================================================================
# Brightloop Software — Backend .gitignore
# =============================================================================

# Environment secrets — NEVER commit these
.env
.env.local
.env.production

# Node modules
node_modules/

# Prisma generated client
node_modules/.prisma/

# Build output (if you add a TypeScript build step later)
dist/
build/

# Logs
logs/
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

